<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">

      <div class="ftr__brand">
        {% if site.logo.src %}
          <img src="{{ site.logo.src | url }}" alt="{{ site.logo.alt }}" width="{{ site.logo.width }}" height="{{ site.logo.height }}" loading="lazy" decoding="async">
        {% endif %}
        <h2>{{ site.legalName }}</h2>
        <p class="ftr__tagline">{{ site.tagline }}</p>
        <a class="ftr__tel" href="{{ site.phone | telHref }}">{{ site.phone }}</a>
        <p class="ftr__region">{{ site.region }}</p>
      </div>

      <div>
        <h2>Services</h2>
        <ul>
          {% for s in services %}
            <li><a href="{{ '/services/' | url }}#{{ s.id }}">{{ s.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div>
        <h2>Service Area</h2>
        <ul>
          {% for a in areas.documented %}
            <li>{{ a }}, TX</li>
          {% endfor %}
          <li>{{ areas.catchAll | capitalize }}</li>
        </ul>
      </div>

    </div>

    <div class="ftr__legal">
      <span>&copy; {{ '' | year }} {{ site.legalName }}. Since {{ site.since }}.</span>
      <span><a href="{{ '/contact/' | url }}">{{ site.cta.secondary }}</a></span>
    </div>

    {% if site.demoNotes %}
      <p class="ftr__note">
        Demo site built by ALVSolutions. Email address, business hours and service
        area still to be confirmed with the owner.
      </p>
    {% endif %}
  </div>
</footer>

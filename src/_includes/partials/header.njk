<header class="hdr">
  <div class="wrap hdr__in">

    {#
      The official logo, scaled only. Its navy field matches the header navy, so
      it reads as art rather than as a pasted rectangle. The badge sets the
      company name at full size but not legibly at header scale, so the name is
      set alongside it in the display face. The logo is never redrawn.
      The image is decorative here because the adjacent text carries the name.
    #}
    <a class="hdr__logo" href="/">
      {% if site.logo.src %}
        <img src="{{ site.logo.src }}" alt="" width="{{ site.logo.width }}" height="{{ site.logo.height }}">
      {% endif %}
      <span class="lockup">
        <span class="lockup__name">{{ site.name }}</span>
        <span class="lockup__sub">Since {{ site.since }}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
          <li>
            <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <a class="btn btn--call hdr__call" href="{{ site.phone | telHref }}">{{ site.phone }}</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mnav">
      <span></span><span></span><span></span>
      <span class="sr-only">Menu</span>
    </button>

  </div>

  <div class="mnav" id="mnav" hidden>
    <nav aria-label="Main, mobile">
      {% for item in site.nav %}
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <a class="btn btn--call" href="{{ site.phone | telHref }}">{{ site.cta.primary }}</a>
  </div>
</header>

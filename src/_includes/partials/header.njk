<header class="hdr">
  <div class="wrap hdr__in">

    <a class="hdr__logo" href="/">
      {% if site.logo.src %}
        <img src="{{ site.logo.src }}" alt="{{ site.logo.alt }}" width="180" height="46">
      {% else %}
        {# Typographic stand-in. Replaced by the official logo file, never redrawn. #}
        <span class="lockup">
          <span class="lockup__name">{{ site.name }}</span>
          <span class="lockup__sub">Since {{ site.since }}</span>
        </span>
      {% endif %}
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
          <li>
            <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <a class="btn btn--call hdr__call" href="{{ site.phone | telHref }}">{{ site.phone }}</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mnav">
      <span></span><span></span><span></span>
      <span class="sr-only">Menu</span>
    </button>

  </div>

  <div class="mnav" id="mnav" hidden>
    <nav aria-label="Main, mobile">
      {% for item in site.nav %}
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <a class="btn btn--call" href="{{ site.phone | telHref }}">{{ site.cta.primary }}</a>
  </div>
</header>
